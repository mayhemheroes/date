# libFuzzer dictionary for HowardHinnant/date's date::parse format-directive scanner.
# Tokens are the strftime-style directives date.h recognizes plus common literal separators
# and field values, to help the fuzzer reach deep into read_signed/scan_keyword/%z/%Z handling.

# format directives
"%Y"
"%y"
"%C"
"%m"
"%d"
"%e"
"%H"
"%I"
"%M"
"%S"
"%p"
"%j"
"%a"
"%A"
"%b"
"%B"
"%h"
"%w"
"%u"
"%U"
"%W"
"%V"
"%G"
"%g"
"%F"
"%T"
"%R"
"%r"
"%D"
"%c"
"%x"
"%X"
"%z"
"%Z"
"%n"
"%t"
"%%"

# common literal separators / fragments
"-"
":"
"/"
" "
"T"
"+0000"
"+0600"
"-0500"
"Z"
"UTC"
"GMT"

# representative field values
"2021-01-01"
"13:24:35"
"23:59:60"
"Sun"
"Sunday"
"Feb"
"February"
"2020-W01-3"
"366"
"0000"
"9999"
